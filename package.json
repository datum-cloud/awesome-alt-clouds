{
  "name": "awesome-alt-clouds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "description": "Astro site for alt-cloud.org — a curated directory of alternative cloud providers",
