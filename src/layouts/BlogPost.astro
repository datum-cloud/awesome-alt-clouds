---
import Base from "./Base.astro";
import PixelIcon from "../components/blog/PixelIcon.astro";
import SidebarShell from "../components/site/SidebarShell.astro";
import { iconForSlug } from "../lib/pixel-icons";
import { formatPostDate, type BlogPost } from "../lib/blog";
import { asset } from "../lib/assets";
import { absoluteUrl, siteRoot } from "../lib/site-urls";

export interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, publishDate, updatedDate, author, tags, draft, heroImage, icon } =
  post.data;

const pageTitle = `${title} | Alt Cloud`;
const canonical = absoluteUrl(`blog/${post.id}`) + "/";
const blogIndexHref = asset("blog/");
const ogImage = heroImage ? absoluteUrl(heroImage.replace(/^\//, "")) : undefined;
const formattedDate = formatPostDate(publishDate);
const formattedUpdated = updatedDate ? formatPostDate(updatedDate) : undefined;
---

<Base title={pageTitle} description={description} canonical={canonical} ogImage={ogImage} nav="blog">
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        datePublished: publishDate.toISOString(),
        dateModified: (updatedDate ?? publishDate).toISOString(),
        author: {
          "@type": "Person",
          name: author,
        },
        publisher: {
          "@type": "Organization",
          name: "Datum Cloud",
          url: siteRoot,
        },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonical,
        },
        ...(heroImage ? { image: absoluteUrl(heroImage.replace(/^\//, "")) } : {}),
      })}
    />
  </Fragment>

  <SidebarShell railLabel="Post details">
    <Fragment slot="rail">
      <div class="rail-block">
        <PixelIcon name={icon ?? iconForSlug(post.id)} class="-ml-3" />
        <p class="mt-4 text-sm">
          {formattedDate}
          {formattedUpdated && formattedUpdated !== formattedDate && <span> · Updated {formattedUpdated}</span>}
        </p>
        <p class="text-sm">By {author}</p>
        {
          tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="tag">#{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </Fragment>

    <article class="max-w-[880px] px-[58px] pt-9 pb-[60px] max-md:px-4 max-md:pt-8 max-md:pb-12">
      <a class="mb-10 inline-block font-mono text-[12px] uppercase" href={blogIndexHref}>&lt; <span class="underline">Back to blog</span></a>
      {
        draft && (
          <div class="notice">
            <strong>Draft preview</strong> — this post is not published in production builds.
          </div>
        )
      }
      <header class="mb-10">
        <h1 class="display-40">{title}</h1>
        <p class="mt-4 text-lg">{description}</p>
      </header>
      <div class="prose-content">
        <slot />
      </div>
    </article>
  </SidebarShell>
</Base>
