---
import Base from "./Base.astro";
import DetailSidebar from "../components/DetailSidebar.astro";
import SidebarShell from "../components/site/SidebarShell.astro";
import DraftBanner from "../components/DraftBanner.astro";
import EmergingBanner from "../components/EmergingBanner.astro";
import { defaultDescription, siteName } from "../lib/site-meta";
import { absoluteUrl } from "../lib/site-urls";
import { asset } from "../lib/assets";
import type { CloudUpdate, MergedCloud } from "../lib/profile";

export interface Props {
  cloud: MergedCloud;
  /** Optional "Provider updates" entries from the profile frontmatter. */
  updates?: CloudUpdate[];
}

const { cloud, updates = [] } = Astro.props;
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const isEmerging = cloud.unverified === true;

const pageTitle = `${cloud.name} | ${siteName}`;
const pageDescription = cloud.tagline || cloud.description || defaultDescription;
const canonical = `${absoluteUrl(cloud.slug)}/`;

const sameAs = [
  cloud.socials?.website,
  cloud.socials?.x,
  cloud.socials?.linkedin,
  cloud.socials?.github,
].filter((url): url is string => Boolean(url));

const profileJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${canonical}#organization`,
      name: cloud.name,
      url: cloud.url,
      description: pageDescription,
      ...(cloud.logo ? { logo: cloud.logo } : {}),
      ...(sameAs.length > 0 ? { sameAs } : {}),
      ...(cloud.headquarters
        ? { address: { "@type": "PostalAddress", addressLocality: cloud.headquarters } }
        : {}),
      ...(cloud.foundedYear ? { foundingDate: String(cloud.foundedYear) } : {}),
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    },
    {
      "@type": "WebPage",
      "@id": canonical,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      mainEntity: { "@id": `${canonical}#organization` },
    },
  ],
};
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  nav="list">
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(profileJsonLd)}
    />
  </Fragment>
  <SidebarShell railLabel={`${cloud.name} facts`}>
    <DetailSidebar slot="rail" cloud={cloud} />

    <article class="max-w-[880px] px-[58px] pt-9 pb-[60px] max-md:px-4 max-md:pt-8 max-md:pb-12">
      <a class="mb-10 inline-block font-mono text-[12px] uppercase" href={asset("list/")}>&lt; <span class="underline">Back to list</span></a>

      {cloud.status === "draft" && <DraftBanner slug={cloud.slug} />}
      {isEmerging && <EmergingBanner cloud={cloud} />}

      <div class="prose-content">
        <slot />
      </div>

      {
        updates.length > 0 && (
          <section class="prose-content mt-10 border-t-2 border-midnight pt-3" aria-labelledby="updates-title">
            <h2 id="updates-title">Provider updates</h2>
            {updates.map((u, i) => (
              <div class={i > 0 ? "mt-6" : undefined}>
                <p class="text-sm">
                  {fmtDate(u.date)} · {u.kind}
                </p>
                <p>
                  <strong>{u.title}</strong>
                  {" — "}
                  {u.body}{" "}
                  {u.url && (
                    <a href={u.url} target="_blank" rel="noopener noreferrer">
                      Read the announcement ↗
                    </a>
                  )}
                </p>
              </div>
            ))}
          </section>
        )
      }
    </article>
  </SidebarShell>
</Base>
