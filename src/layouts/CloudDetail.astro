---
import Base from "./Base.astro";
import DetailSidebar from "../components/DetailSidebar.astro";
import DetailTopBar from "../components/DetailTopBar.astro";
import SiteModals from "../components/SiteModals.astro";
import { defaultDescription, defaultTitle } from "../lib/site-meta";
import { absoluteUrl } from "../lib/site-urls";
import type { MergedCloud } from "../lib/profile";

export interface Props {
  cloud: MergedCloud;
  featuredSlugs: string[];
}

const { cloud, featuredSlugs } = Astro.props;

const pageTitle = `${cloud.name} — ${defaultTitle}`;
const pageDescription = cloud.tagline || cloud.description || defaultDescription;
const canonical = absoluteUrl(cloud.slug);
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}>
  <div class="flex flex-col md:flex-row min-h-screen">
    <DetailSidebar cloud={cloud} />

    <main class="flex-1 p-5 md:p-8 min-w-0">
      <DetailTopBar featuredSlugs={featuredSlugs} />

      <article class="cloud-detail max-w-4xl">
        <header class="mb-8">
          <div class="text-xs font-medium text-warm-stone uppercase tracking-wider mb-2">
            {cloud.categories.join(" · ")}
          </div>
          <h1 class="font-serif text-3xl md:text-4xl font-semibold text-rich-earth leading-tight">
            {cloud.name}
          </h1>
          {
            cloud.tagline && (
              <p class="mt-3 text-base text-warm-stone leading-relaxed">{cloud.tagline}</p>
            )
          }
        </header>

        <div class="prose-content">
          <slot />
        </div>
      </article>
    </main>
  </div>

  <SiteModals />
</Base>

<style is:global>
  .prose-content {
    color: var(--color-rich-earth);
    line-height: 1.7;
  }

  .prose-content > * + * {
    margin-top: 1.25rem;
  }

  .prose-content h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-rich-earth);
    margin-top: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-clay-beige);
  }

  .prose-content h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-rich-earth);
    margin-top: 1.75rem;
  }

  .prose-content h4 {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-rich-earth);
    margin-top: 1.25rem;
  }

  .prose-content p {
    color: var(--color-warm-stone);
  }

  .prose-content a {
    color: var(--color-bright-tangerine);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }

  .prose-content a:hover {
    border-bottom-color: var(--color-bright-tangerine);
  }

  .prose-content ul,
  .prose-content ol {
    color: var(--color-warm-stone);
    padding-left: 1.5rem;
  }

  .prose-content ul {
    list-style: disc;
  }

  .prose-content ol {
    list-style: decimal;
  }

  .prose-content li + li {
    margin-top: 0.4rem;
  }

  .prose-content code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--color-clay-beige);
    color: var(--color-rich-earth);
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
  }

  .prose-content pre {
    background-color: var(--color-charcoal);
    color: var(--color-cream);
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    font-size: 0.875rem;
  }

  .prose-content pre code {
    background: transparent;
    color: inherit;
    padding: 0;
  }

  .prose-content blockquote {
    border-left: 3px solid var(--color-soft-sage);
    padding-left: 1rem;
    color: var(--color-warm-stone);
    font-style: italic;
  }

  .prose-content strong {
    color: var(--color-rich-earth);
    font-weight: 600;
  }
</style>
