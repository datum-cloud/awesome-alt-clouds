---
/** One square logo tile of the Grid view (Figma node 1:2077). */
import { linkAttrs, type ListItem } from "../../lib/list-items";

export interface Props {
  item: ListItem;
}
const { item } = Astro.props;
---

<li class="border-r border-b border-midnight" data-item>
  <a {...linkAttrs(item)} class="group relative grid h-full place-items-center overflow-hidden hover:bg-paper focus-visible:bg-paper"
    title={item.name}>
    <img src={item.logo} alt="" width="40" height="40" class="size-10 object-contain" loading="lazy" decoding="async" />
    <span
      class="absolute inset-x-0 bottom-0 translate-y-full truncate bg-midnight px-1.5 py-1 text-center font-mono text-[10px] leading-[14px] text-white uppercase transition-transform duration-150 ease-[ease] group-hover:translate-y-0 group-focus-visible:translate-y-0">{item.name}</span>
  </a>
</li>
