---
import { asset } from "../lib/assets";
import { COMPARE_ROWS, formatCompareValue, type CompareCloud } from "../lib/compare";
import { externalLinkIcon } from "../lib/external-link-icon";
import ScoreBadge from "./ScoreBadge.astro";

export interface Props {
  columns: (CompareCloud | undefined)[];
}

const { columns } = Astro.props;
const filledColumns = columns.filter((c): c is CompareCloud => c !== undefined);
---

<div class="overflow-x-auto rounded-xl border border-clay-beige bg-white">
  {
    filledColumns.length === 0 ? (
      <div class="p-8 text-center text-warm-stone">
        <p class="text-base mb-1">Select two or three providers to compare</p>
        <p class="text-sm text-warm-stone/80">
          Use the pickers above or share a link like <code class="text-xs">?a=neon&b=hetzner</code>
        </p>
      </div>
    ) : (
      <table class="compare-table w-full min-w-[640px] table-fixed border-collapse text-sm" id="compare-table">
        <colgroup>
          <col style="width: 140px" />
          {filledColumns.map(() => (
            <col />
          ))}
        </colgroup>
        <thead>
          <tr class="border-b border-clay-beige bg-cream">
            <th
              scope="col"
              class="text-left font-serif font-semibold text-rich-earth px-4 py-3 w-[140px]">
              Attribute
            </th>
            {filledColumns.map((cloud) => (
              <th
                scope="col"
                class="text-left font-serif font-semibold text-rich-earth px-4 py-3 break-words">
                <div class="flex flex-col gap-1">
                  {cloud.hasProfile ? (
                    <a
                      href={asset(`${cloud.slug}/`)}
                      class="hover:text-bright-tangerine transition-colors no-underline">
                      {cloud.name}
                    </a>
                  ) : (
                    <span>{cloud.name}</span>
                  )}
                  <a
                    href={cloud.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-xs font-normal text-bright-tangerine hover:underline">
                    <span>Visit</span>
                    <span set:html={externalLinkIcon} />
                  </a>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {COMPARE_ROWS.map((row) => (
            <tr class="border-b border-clay-beige last:border-b-0">
              <th
                scope="row"
                class="text-left text-warm-stone font-medium px-4 py-3 align-top whitespace-nowrap">
                {row.label}
              </th>
              {filledColumns.map((cloud) => (
                <td class="text-rich-earth px-4 py-3 align-top break-words">
                  {row.key === "score" ? (
                    <ScoreBadge score={cloud.score} size="sm" />
                  ) : (
                    formatCompareValue(row.key, cloud)
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</div>
