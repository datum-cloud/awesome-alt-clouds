---
export interface Props {
  slug: string;
}
const { slug } = Astro.props;
const editUrl = `https://github.com/datum-cloud/awesome-alt-clouds/edit/main/src/content/clouds/${slug}.mdx`;
---

<div class="notice" role="note" aria-label="Draft profile notice">
  <strong>Auto-generated profile</strong> — pending human review. Found an inaccuracy?
  <a href={editUrl} target="_blank" rel="noopener noreferrer">Edit on GitHub ↗</a>
</div>
