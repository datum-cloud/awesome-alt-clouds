---
import { graduationIssueUrl } from "../lib/github";

export interface Props {
  cloud: { name: string; url: string };
}

const { cloud } = Astro.props;
const requestUrl = graduationIssueUrl(cloud);
---

<div class="notice" role="note" aria-label="Emerging and unverified provider notice">
  <strong>Emerging &amp; Unverified provider</strong> — listed, but still pending verification of
  pricing, self-service, or SLA details. Think it now qualifies?
  <a href={requestUrl} target="_blank" rel="noopener noreferrer">Request a re-check ↗</a>
</div>
