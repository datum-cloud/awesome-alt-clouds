---
/**
 * Cloud detail rail (Figma node 1:2641): identity block, Website / GitHub buttons,
 * Category, Tags, Key facts. Rendered inside SidebarShell's `rail` slot.
 */
import { logoUrl } from "../lib/clouds";
import type { MergedCloud } from "../lib/profile";
import { tagLabel } from "../lib/taxonomy";
import CompareButton from "./CompareButton.astro";

export interface Props {
  cloud: MergedCloud;
}

const { cloud } = Astro.props;

const logoSrc = cloud.logo || logoUrl(cloud.url, 128);
const website = cloud.socials?.website || cloud.url;
const github = cloud.socials?.github;

const pricingLabel: Record<string, string> = {
  hourly: "Hourly",
  monthly: "Monthly",
  "usage-based": "Usage-based",
  subscription: "Subscription",
  mixed: "Mixed",
};

const facts: [string, string][] = [
  ["Criteria", `${cloud.score}/3`],
  ...(cloud.pricingModel ? [["Pricing", pricingLabel[cloud.pricingModel]] as [string, string]] : []),
  ...(cloud.openSource !== undefined ? [["Open source", cloud.openSource ? "Yes" : "No"] as [string, string]] : []),
  ...(cloud.headquarters ? [["Headquarters", cloud.headquarters] as [string, string]] : []),
  ...(cloud.foundedYear ? [["Founded", String(cloud.foundedYear)] as [string, string]] : []),
  ...(cloud.regions?.length ? [["Regions", cloud.regions.join(", ")] as [string, string]] : []),
  ...(cloud.dateAdded ? [["Date listed", cloud.dateAdded] as [string, string]] : []),
];

const socials = [
  ["X", cloud.socials?.x],
  ["LinkedIn", cloud.socials?.linkedin],
].filter((s): s is [string, string] => Boolean(s[1]));
---

<div class="rail-block flex flex-col items-center gap-3 pr-10 pb-[60px] text-center">
  {logoSrc && <img src={logoSrc} alt="" width="80" height="80" class="size-20 object-contain" />}
  <h1 class="font-mono text-[30px] leading-[38px] font-bold wrap-anywhere">{cloud.name}</h1>
  {(cloud.tagline || cloud.description) && <p class="text-sm">{cloud.tagline || cloud.description}</p>}
</div>

<a class="btn btn--dark btn--block min-h-[82px] border-t-2 border-midnight" href={website} target="_blank" rel="noopener noreferrer">
  <span class="btn__label">Website</span><span aria-hidden="true">↗</span>
</a>
{
  github && (
    <a class="btn btn--outline btn--block min-h-[82px] border-t-2 border-midnight" href={github} target="_blank" rel="noopener noreferrer">
      <span class="btn__label">GitHub</span>
      <span aria-hidden="true">↗</span>
    </a>
  )
}

<div class="rail-block border-t-2 border-midnight py-10">
  <p class="field-label mb-2">Category:</p>
  <p class="text-sm">{cloud.categories.join(", ")}</p>
</div>

{
  (cloud.tags?.length || cloud.unverified) && (
    <div class="rail-block border-t-2 border-midnight py-10">
      <p class="field-label mb-2">Tags:</p>
      <ul class="flex flex-wrap gap-2">
        {cloud.tags?.map((t) => (
          <li class="tag">{tagLabel(t)}</li>
        ))}
        {cloud.unverified && <li class="tag">Emerging &amp; Unverified</li>}
      </ul>
    </div>
  )
}

<div class="rail-block border-t-2 border-midnight py-10">
  <p class="field-label mb-0">Key facts:</p>
  <dl>
    {
      facts.map(([k, v]) => (
        <div class="flex min-h-12 items-center justify-between gap-4 border-b border-midnight py-2 text-[12px] leading-4">
          <dt class="text-midnight/60">{k}</dt>
          <dd class="text-right">{v}</dd>
        </div>
      ))
    }
  </dl>
  {
    socials.length > 0 && (
      <p class="mt-6 flex gap-4 text-xs">
        {socials.map(([label, href]) => (
          <a class="underline" href={href} target="_blank" rel="noopener noreferrer">
            {label} ↗
          </a>
        ))}
      </p>
    )
  }
  <CompareButton slug={cloud.slug} name={cloud.name} class="mt-6" />
</div>
