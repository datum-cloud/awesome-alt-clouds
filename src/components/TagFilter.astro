---
import { getTagCounts } from "../lib/clouds";
import { groupTagCounts, tagLabel } from "../lib/taxonomy";

const groups = groupTagCounts(getTagCounts());

const SECTIONS = [
  {
    scope: "workload",
    title: "Workload tags",
    hint: "What the workload is. Only applies to Workload Clouds.",
  },
  {
    scope: "all",
    title: "Tags for every category",
    hint: "Capabilities, region and verification status. Apply to any cloud.",
  },
] as const;
---

<div id="tagFlyoutRoot">
  <button
    type="button"
    id="tagFlyoutBtn"
    aria-expanded="false"
    aria-controls="tagFlyout"
    class="inline-flex items-center gap-2 pl-3 pr-3 py-2 bg-cream border-2 border-clay-beige rounded-lg text-rich-earth text-sm hover:border-soft-sage focus:border-soft-sage focus:outline-none focus:ring-2 focus:ring-soft-sage/15 transition-all">
    <svg
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M7 7h.01M7 3h5a2 2 0 011.41.59l7 7a2 2 0 010 2.82l-5 5a2 2 0 01-2.82 0l-7-7A2 2 0 013 10V5a2 2 0 012-2z"
      ></path>
    </svg>
    <span>Tags</span>
    <span
      id="tagFlyoutBadge"
      class="hidden min-w-[1.25rem] px-1.5 rounded-full bg-rich-earth text-cream text-[11px] leading-5 text-center">
      0
    </span>
  </button>

  <div
    id="tagFlyout"
    role="dialog"
    aria-label="Explore by tag"
    data-tag-filter
    class="hidden absolute inset-x-0 top-full mt-2 z-40 max-h-[70vh] overflow-y-auto bg-white border border-clay-beige rounded-xl shadow-xl px-5 py-4">
    <div class="flex items-center justify-between gap-3">
      <span class="font-serif text-sm font-semibold text-rich-earth">
        Explore by tag
        <span class="font-sans text-xs font-normal text-warm-stone ml-2">
          what it does, and what it's like
        </span>
      </span>
      <span class="flex items-center gap-3">
        <button
          type="button"
          data-tag-clear
          class="hidden text-xs text-bright-tangerine hover:underline">
          Clear tags
        </button>
        <button
          type="button"
          data-tag-flyout-close
          aria-label="Close tag explorer"
          class="p-1 rounded text-warm-stone hover:text-rich-earth hover:bg-clay-beige transition-colors">
          <svg
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </span>
    </div>
  {
    SECTIONS.map(({ scope, title, hint }) => {
      const sectionGroups = groups.filter((g) => g.scope === scope);
      return (
        sectionGroups.length > 0 && (
          <section data-tag-section={scope} class="mt-4 first-of-type:mt-4">
            <h3 class="text-xs font-semibold text-rich-earth mb-0.5">{title}</h3>
            <p class="text-[11px] text-warm-stone mb-3">{hint}</p>
            <div class="grid gap-x-8 gap-y-4 sm:grid-cols-2 xl:grid-cols-3">
              {sectionGroups.map((group) => (
                <div data-tag-group>
                  <div class="text-[11px] font-semibold uppercase tracking-wider text-warm-stone mb-2">
                    {group.label}
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    {group.tags.map(({ tag, count }) => (
                      <button
                        type="button"
                        data-tag={tag}
                        data-label={tagLabel(tag)}
                        aria-pressed="false"
                        class="tag-chip px-2.5 py-1 rounded-full text-xs border border-clay-beige text-warm-stone hover:border-soft-sage hover:text-rich-earth transition-colors aria-pressed:bg-rich-earth aria-pressed:text-cream aria-pressed:border-rich-earth">
                        {tagLabel(tag)} <span data-tag-count class="font-mono opacity-60">{count}</span>
                      </button>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )
      );
    })
  }
  </div>
</div>
