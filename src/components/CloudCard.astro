---
import { asset } from "../lib/assets";
import type { CloudWithSlug } from "../lib/clouds";
import { compareIconAdd } from "../lib/compare-toggle-icons";
import { graduationIssueUrl } from "../lib/github";
import { tagLabel } from "../lib/taxonomy";

export interface Props {
  cloud: CloudWithSlug;
  featured: boolean;
}

const { cloud, featured } = Astro.props;

const score = cloud.score ?? 3;
const badgeClass =
  score === 3 ? "bg-soft-sage text-rich-earth" : "bg-clay-beige text-warm-stone";
const badgeText = `${score}/3`;
const tags = cloud.tags ?? [];
const isEmerging = cloud.unverified === true;
/** Filterable tags: real tags plus the `unverified` status pseudo-tag. */
const filterTags = isEmerging ? [...tags, "unverified"] : tags;
const graduationHref = isEmerging ? graduationIssueUrl(cloud) : null;

let host = "";
try {
  host = new URL(cloud.url).hostname;
} catch {
  host = "";
}
const fallbackLetter = cloud.name.charAt(0).toUpperCase();
const detailHref = asset(`${cloud.slug}/`);
---

<article
  class:list={[
    "cloud-card bg-white border border-clay-beige rounded-xl p-5 relative",
    featured && "cloud-card--featured",
  ]}
  data-name={cloud.name.toLowerCase()}
  data-description={cloud.description.toLowerCase()}
  data-categories={cloud.categories.join("|")}
  data-tags={filterTags.join("|")}
  data-date-added={cloud.dateAdded ?? ""}>
  <button
    type="button"
    data-compare-toggle
    data-compare-compact
    data-compare-slug={cloud.slug}
    data-compare-name={cloud.name}
    aria-pressed="false"
    aria-label={`Add ${cloud.name} to compare`}
    class="compare-toggle compare-toggle--compact absolute top-3 right-3 z-10 w-7 h-7 flex items-center justify-center rounded-full text-warm-stone bg-cream border border-clay-beige hover:border-soft-sage hover:text-rich-earth transition-colors disabled:opacity-50 disabled:cursor-not-allowed aria-pressed:bg-soft-sage aria-pressed:border-soft-sage aria-pressed:text-rich-earth">
    <span data-compare-label class="flex items-center justify-center" set:html={compareIconAdd} />
  </button>
  <div class="flex items-start gap-3.5 mb-3.5">
    <div
      class="w-11 h-11 rounded-[10px] flex-shrink-0 overflow-hidden flex items-center justify-center font-serif font-semibold text-lg text-warm-stone bg-cream">
      {
        host ? (
          <img
            src={`https://www.google.com/s2/favicons?domain=${host}&sz=64`}
            alt={fallbackLetter}
            class="w-full h-full object-contain"
            loading="lazy"
            onerror={`this.style.display='none';this.parentElement.textContent='${fallbackLetter}';`}
          />
        ) : (
          fallbackLetter
        )
      }
    </div>
    <div class="flex-1 min-w-0">
      {
        featured ? (
          <a
            href={detailHref}
            class="font-serif text-lg font-semibold text-rich-earth truncate block hover:text-bright-tangerine transition-colors no-underline">
            {cloud.name}
          </a>
        ) : (
          <div class="font-serif text-lg font-semibold text-rich-earth truncate">{cloud.name}</div>
        )
      }
      <div class="text-xs text-warm-stone">{cloud.categories.join(" · ")}</div>
    </div>
  </div>

  <div class="flex gap-2 mb-3.5">
    <div
      class={`badge px-2.5 py-1 rounded-full text-[11px] font-medium ${badgeClass} flex items-center gap-1`}
      title={`Criteria Score: ${score}/3`}>
      {badgeText}
    </div>
    {
      isEmerging && (
        <div
          class="badge px-2.5 py-1 rounded-full text-[11px] font-medium bg-blue-50 text-blue-800 border border-blue-200"
          title="Emerging & Unverified: a criterion still needs independent verification">
          🔵 Emerging & Unverified
        </div>
      )
    }
  </div>

  <p class="text-sm text-warm-stone leading-relaxed mb-3.5">{cloud.description}</p>

  {
    tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-3.5" aria-label="Tags">
        {tags.map((tag) => (
          <span class="px-2 py-0.5 rounded-full text-[11px] bg-cream text-warm-stone border border-clay-beige">
            {tagLabel(tag)}
          </span>
        ))}
      </div>
    )
  }

  <div class="flex items-center justify-between gap-3 pt-3.5 border-t border-clay-beige">
    <a
      href={cloud.url}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium text-bright-tangerine hover:underline inline-flex items-center gap-1.5 transition-all">
      Visit →
    </a>
    <div class="flex items-center gap-3">
      {
        graduationHref && (
          <a
            href={graduationHref}
            target="_blank"
            rel="noopener noreferrer"
            title="Think this now meets the criteria? Open a re-check request."
            class="text-xs font-medium text-warm-stone hover:text-rich-earth inline-flex items-center gap-1 transition-colors no-underline">
            Request re-check
          </a>
        )
      }
      {
        featured && (
          <a
            href={detailHref}
            class="text-xs font-medium text-warm-stone hover:text-rich-earth inline-flex items-center gap-1 transition-colors no-underline">
            Details →
          </a>
        )
      }
    </div>
  </div>
</article>
