---
import { asset } from "../lib/assets";
import { categoryToSlug } from "../lib/clouds";
import { EMERGING_CATEGORY } from "../lib/github";
import SidebarFooterNav from "./SidebarFooterNav.astro";

export type ActivePage = "directory" | "watchlist" | "emerging" | "blog" | "compare";

export interface Props {
  activePage?: ActivePage;
}

const { activePage = "directory" } = Astro.props;

const homeHref = asset("");
const watchlistHref = asset("watchlist/");
const emergingHref = asset(`categories/${categoryToSlug(EMERGING_CATEGORY)}/`);
const blogHref = asset("blog/");
const compareHref = asset("compare/");

const navClass = (page: ActivePage) =>
  [
    "flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm no-underline transition-colors",
    activePage === page
      ? "bg-rich-earth text-cream font-medium"
      : "text-warm-stone hover:text-rich-earth hover:bg-clay-beige",
  ].join(" ");
---

<aside
  class="flex flex-col w-full md:w-[280px] md:flex-shrink-0 bg-cream md:border-r border-clay-beige px-4 py-6 md:sticky md:top-0 md:h-screen md:overflow-y-auto">
  <div class="mb-6 pb-6 border-b border-clay-beige">
    <a href={homeHref} class="flex items-center gap-3 mb-2 no-underline">
      <img
        src={asset("altclouds-logo.png")}
        alt="Alt Clouds"
        width="40"
        height="40"
        class="rounded-lg"
      />
      <div>
        <span class="font-serif text-xl font-semibold text-rich-earth">Awesome Alt Clouds</span>
      </div>
    </a>
    <p class="text-[13px] text-bright-tangerine font-medium mb-1">
      When you Need Something .. Specialized!
    </p>
    <p class="text-[13px] text-warm-stone leading-snug">
      Discover specialized infrastructure providers built for developers who think different
    </p>
  </div>

  <nav class="flex flex-col gap-1 mb-6" aria-label="Site sections">
    <a href={homeHref} class={navClass("directory")}>
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
        ></path>
      </svg>
      <span>Directory</span>
    </a>
    <a href={watchlistHref} class={navClass("watchlist")}>
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
        ></path>
      </svg>
      <span>Watchlist</span>
    </a>
    <a href={emergingHref} class={navClass("emerging")}>
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"
        ></path>
      </svg>
      <span>Emerging & Unverified</span>
    </a>
    <a href={blogHref} class={navClass("blog")}>
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
        ></path>
      </svg>
      <span>Blog</span>
    </a>
    <a href={compareHref} class={navClass("compare")}>
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v2M9 7h6"
        ></path>
      </svg>
      <span>Compare</span>
    </a>
  </nav>

  <SidebarFooterNav showMenu={false} />
</aside>
