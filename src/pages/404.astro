---
import Base from "../layouts/Base.astro";
import { asset } from "../lib/assets";

const links = [
  { href: asset("list/"), label: "Browse the list", hint: "Every alternative cloud provider" },
  { href: asset("compare/"), label: "Compare providers", hint: "Side by side, up to three" },
  { href: asset("submit/"), label: "Submit a provider", hint: "Add one that is missing" },
];
---

<Base
  title="Page not found | Alternative Cloud Providers"
  description="This page does not exist. Browse the directory of alternative cloud providers or search for a provider by name."
  showCompareTray={false}>
  <section class="px-10 py-20 max-md:px-4 max-md:py-12">
    <p class="eyebrow mb-4">Error 404</p>
    <h1 class="display-80 max-w-4xl">We couldn't find that page</h1>
    <p class="mt-6 max-w-2xl text-lg">
      The link may be mistyped, or the provider may have been renamed or removed from the list.
    </p>
    <ul class="mt-12 grid max-w-[960px] grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-px border border-midnight bg-midnight">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="flex h-full flex-col gap-2 bg-white p-7 hover:bg-mint">
              <span class="display text-lg underline">{link.label} →</span>
              <span class="text-sm">{link.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
