---
/**
 * Landing page (Figma node 1:1910). The filterable directory lives at /list/.
 */
import HeroClouds from "../components/home/HeroClouds.astro";
import InlineSvg from "../components/ui/InlineSvg.astro";
import Base from "../layouts/Base.astro";
import { asset } from "../lib/assets";
import { CATEGORY_BLURBS } from "../lib/categories";
import { categoryToSlug, cloudLink, clouds, countByCategory, logoUrl, newestClouds } from "../lib/clouds";
import { getFeaturedSlugs } from "../lib/profile";
import { CLOUDS_JSON, LLMS_TXT, REPO_URL } from "../lib/site-links";
import { CATEGORIES } from "../lib/taxonomy";

const total = clouds.length;
const pass3 = clouds.filter((c) => c.score === 3).length;
const pass2 = clouds.filter((c) => c.score === 2).length;
const publishedSlugs = await getFeaturedSlugs();
const base = asset("");

const categories = CATEGORIES.map((name) => {
  const [first, ...rest] = name.split(" ");
  return {
    first,
    rest: rest.join(" "),
    count: countByCategory(name),
    blurb: CATEGORY_BLURBS[name] ?? "",
    href: asset(`list/?category=${categoryToSlug(name)}`),
  };
});

const newest = newestClouds(8).map((cloud) => ({ cloud, ...cloudLink(cloud, publishedSlugs, base) }));

const stats = [
  { label: "Total providers", value: total, lead: true },
  { label: "Pass 3/3 checks", value: pass3, lead: false },
  { label: "Pass 2/3 checks", value: pass2, lead: false },
];

/* Shared section layout: title column (331px) + content column. */
const row =
  "mt-10 flex flex-wrap gap-x-20 gap-y-10 border-t-2 border-midnight px-20 pt-20 pb-10 max-md:px-1 max-md:pt-10 max-md:pb-4 [&>:last-child]:min-w-0 [&>:last-child]:flex-[1_1_400px]";
const rowTitle = "max-w-full flex-[0_0_331px]";

const criteria = [
  ["Public Pricing:", "You can see what you'll pay before signing up."],
  ["Self-Service Signup:", "You can start using the service today."],
  ["Status Page / SLA:", "Public commitment to uptime and transparency."],
];
---

<Base includeHomeJsonLd cloudCount={total}>
  <script is:inline data-base={base}>
    // Old directory links (/?search=…, /?tags=…, /#workload-clouds, /#about) moved off the homepage.
    (function () {
      const q = new URLSearchParams(location.search);
      const hash = location.hash.slice(1);
      const base = document.currentScript.dataset.base;
      const modal = { about: "definitions/", resources: "definitions/", extension: "extension/" }[hash];
      if (modal) return location.replace(base + modal);
      if (q.has("search") || q.has("tags") || q.has("category") || (hash && /^[a-z0-9-]+-clouds$/.test(hash))) {
        if (hash && !q.has("category")) q.set("category", hash);
        location.replace(base + "list/" + (q.toString() ? "?" + q.toString() : ""));
      }
    })();
  </script>

  <div class="p-10 max-md:p-4">
    <section aria-labelledby="home-title">
      <div class="relative h-[500px] overflow-hidden max-md:h-auto max-md:min-h-[360px]">
        <HeroClouds />
        <div
          class="relative z-[1] flex flex-col items-center gap-[18px] px-4 pt-[66px] text-center text-midnight max-md:pt-10 max-md:pb-12">
          <InlineSvg name="logoHandHero" class="mirror-x h-auto w-[184px]" />
          <h1 id="home-title" class="display-80 mt-3.5">Make more (awesome) clouds!</h1>
          <p class="text-2xl font-semibold max-md:text-lg max-md:leading-6">
            A curated directory to help builders find specialized clouds fit for their needs
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-20 bg-midnight p-20 text-white max-md:gap-10 max-md:px-5 max-md:py-10">
        <div class="flex flex-[0_1_440px] flex-col gap-7">
          <h2 class="display-40">Find the<br />right cloud<br />for the job.</h2>
          <p class="text-lg">
            Awesome Alt-Clouds is an open directory of {total} alternatives to AWS, Azure, and Google
            Cloud. Find and compare providers for what you’re building, from a Postgres database to an
            inference endpoint.
          </p>
          <a class="btn btn--mint btn--lg self-start" href={asset("list/")}>
            <span class="btn__label">Find your cloud</span><span aria-hidden="true">→</span>
          </a>
        </div>
        <dl
          class="flex flex-[1_1_480px] items-center justify-between gap-6 self-stretch border-y border-white px-40 text-center max-xl:px-10 max-md:grid max-md:basis-auto max-md:grid-cols-3 max-md:gap-2 max-md:px-0">
          {
            stats.map(({ label, value, lead }) => (
              <div class="flex flex-col-reverse py-10 max-md:py-6">
                <dt
                  class:list={[
                    "max-md:text-[12px] max-md:leading-4",
                    lead ? "text-lg font-semibold" : "text-sm opacity-80",
                  ]}>
                  {label}
                </dt>
                <dd
                  class:list={[
                    "font-mono font-extrabold max-md:text-[36px] max-md:leading-10",
                    lead ? "text-[80px] leading-[80px]" : "text-[60px] leading-[60px]",
                  ]}>
                  {value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class:list={[row, "items-start"]} aria-labelledby="browse-title">
      <h2 id="browse-title" class:list={["display-40", rowTitle]}>Browse by what you’re building</h2>
      <ul class="grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-10">
        {
          categories.map((cat) => (
            <li class="flex flex-col gap-4">
              <a class="group font-mono text-[20px] leading-6 font-extrabold uppercase" href={cat.href}>
                <span class="underline group-hover:bg-mint">
                  {cat.first}
                  <br />
                  {cat.rest}
                </span>{" "}
                <span class="font-light">({cat.count})</span> <span aria-hidden="true">→</span>
              </a>
              <p class="text-sm">{cat.blurb}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class:list={[row, "items-start"]} aria-labelledby="criteria-title">
      <div class:list={[rowTitle, "flex flex-col gap-4"]}>
        <h2 id="criteria-title" class="display-40">Easy as 1,2,3.</h2>
        <p>To be included, every provider here has to meet at least 2 of 3 criteria</p>
        <a class="arrow-link self-start" href={asset("definitions/#criteria")}>Learn more →</a>
      </div>
      <ul class="flex flex-col gap-7">
        {
          criteria.map(([title, body]) => (
            <li class="flex items-center gap-4">
              <span class="grid size-10 flex-none place-items-center border border-midnight" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M4 10.5l4 4 8-9" stroke-linecap="square" />
                </svg>
              </span>
              <p class="text-sm">
                <strong class="font-semibold">{title}</strong>
                <br />
                {body}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class:list={[row, "items-center"]} aria-labelledby="new-title">
      <div class:list={[rowTitle, "flex flex-col gap-4"]}>
        <h2 id="new-title" class="display-40">Who's new here?</h2>
        <p>Recently added in our alt-cloud universe</p>
        <a class="arrow-link self-start" href={asset("list/?sort=recent")}>Browse all →</a>
      </div>
      <ul class="grid grid-cols-8 gap-px border border-midnight bg-midnight max-md:grid-cols-4">
        {
          newest.map(({ cloud, href, external }) => (
            <li>
              <a
                class="grid h-[120px] place-items-center bg-white transition-colors duration-150 ease-[ease] hover:bg-mint max-md:h-[88px]"
                href={href}
                title={cloud.name}
                {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                <img src={logoUrl(cloud.url, 128)} alt={cloud.name}
                  width="40"
                  height="40"
                  class="size-10 object-contain" loading="lazy" decoding="async" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class:list={[row, "items-start"]} aria-labelledby="open-title">
      <div class:list={[rowTitle, "flex flex-col gap-4"]}>
        <h2 id="open-title" class="display-40">Open by design</h2>
        <p>
          This directory is open sourced so that anyone can submit a provider in the public GitHub
          repo. Each submission is checked against the public criteria and approved by a maintainer,
          with the README as the single source of truth.
        </p>
        <p class="text-sm">
          <strong class="font-semibold">Disclosure:</strong> this directory is maintained by Datum, and
          Datum is also listed in it as a provider.
        </p>
      </div>
      <div class="flex flex-col gap-7">
        <div class="flex flex-col gap-3">
          <p>Don't see your favorite provider?</p>
          <a class="btn btn--dark btn--lg self-start" href={asset("submit/")}>
            <span class="btn__label">Submit them here</span><span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="flex flex-col gap-4">
          <li><a class="arrow-link" href={REPO_URL}>Source on GitHub →</a></li>
          <li><a class="arrow-link" href={CLOUDS_JSON}>clouds.json →</a></li>
          <li><a class="arrow-link" href={LLMS_TXT}>llms.txt →</a></li>
        </ul>
      </div>
    </section>
  </div>
</Base>
