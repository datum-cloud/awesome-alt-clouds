  <!-- Hydration data: serialized clouds for client-side filter/search/sort -->
  <script
    is:inline
    id="clouds-data"
    type="application/json"
    set:html={JSON.stringify(sortedClouds)}
  />

  <script>
    type Cloud = {
      name: string;
      url: string;
      description: string;
      score: 2 | 3;
      categories: string[];
      dateAdded?: string;
    };

    const dataEl = document.getElementById("clouds-data");
    const altClouds: Cloud[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];

    let currentCategory = "All";
    let searchTerm = "";
    let currentSort: "alphabetical" | "recent" = "alphabetical";

    const MODAL_HASHES: Record<string, string> = {
      aboutModal: "about",
      resourcesModal: "resources",
      extensionModal: "extension",
    };
    const HASH_MODALS: Record<string, string> = Object.fromEntries(
      Object.entries(MODAL_HASHES).map(([k, v]) => [v, k])
    );

    function categoryToSlug(cat: string): string {
      return cat
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "");
    }

    function slugToCategory(slug: string): string {
      const cats = getCategories();
      return cats.find((c) => categoryToSlug(c) === slug) || "All";
    }

    function getCategories(): string[] {
      const set = new Set<string>();
      for (const c of altClouds) for (const cat of c.categories) set.add(cat);
      return ["All", ...[...set].sort()];
    }

    function openModal(id: string) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.remove("hidden");
      el.classList.add("flex");
      document.body.style.overflow = "hidden";
      const hash = MODAL_HASHES[id];
      if (hash) history.pushState({ modal: id }, "", "#" + hash);
    }

    function closeModal(id: string) {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.add("hidden");
      el.classList.remove("flex");
      document.body.style.overflow = "";
      if (MODAL_HASHES[id] && location.hash === "#" + MODAL_HASHES[id]) {
        history.pushState({}, "", location.pathname + location.search);
      }
    }

    document.querySelectorAll<HTMLElement>("[data-modal-trigger]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-modal-trigger");
        if (id) openModal(id);
      });
    });

    document.querySelectorAll<HTMLElement>("[data-modal-close]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-modal-close");
        if (id) closeModal(id);
      });
    });

    document.querySelectorAll<HTMLElement>(".modal-overlay").forEach((overlay) => {
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal(overlay.id);
      });
    });

    // Mobile drawer
    const drawer = document.getElementById("mobileDrawer");
    const drawerOverlay = document.getElementById("drawerOverlay");
    const burgerBtn = document.getElementById("burgerBtn");
    const drawerClose = document.getElementById("drawerClose");

    function openDrawer() {
      drawer?.classList.remove("-translate-x-full");
      drawer?.classList.add("translate-x-0");
      drawerOverlay?.classList.remove("hidden");
      drawerOverlay?.classList.add("block");
      document.body.style.overflow = "hidden";
    }
    function closeDrawer() {
      drawer?.classList.add("-translate-x-full");
      drawer?.classList.remove("translate-x-0");
      drawerOverlay?.classList.add("hidden");
      drawerOverlay?.classList.remove("block");
      if (!document.querySelector(".modal-overlay.flex")) {
        document.body.style.overflow = "";
      }
    }
    burgerBtn?.addEventListener("click", openDrawer);
    drawerClose?.addEventListener("click", closeDrawer);
    drawerOverlay?.addEventListener("click", closeDrawer);

    // ESC closes modals/drawer + clears search
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const active = document.activeElement as HTMLElement | null;
      if (active?.id === "searchInput" && searchTerm) {
        clearSearch();
        active.blur();
        return;
      }
      document.querySelectorAll<HTMLElement>(".modal-overlay.flex").forEach((m) => {
        m.classList.add("hidden");
        m.classList.remove("flex");
      });
      if (HASH_MODALS[location.hash.slice(1)]) {
        history.pushState({}, "", location.pathname + location.search);
      }
      closeDrawer();
      document.body.style.overflow = "";
    });

    // Categories rendering
    function renderCategories() {
      const cats = getCategories();
      const counts: Record<string, number> = { All: altClouds.length };
      for (const c of altClouds) {
        for (const cat of c.categories) counts[cat] = (counts[cat] || 0) + 1;
      }
      const html = cats
        .map((cat) => {
          const isActive = cat === currentCategory;
          return `<button data-category="${cat.replace(/"/g, "&quot;")}" class="gap-2 [&>span]:text-left category-item flex justify-between items-center px-3 py-2 rounded-lg cursor-pointer text-sm transition-all border border-transparent ${
            isActive
              ? "bg-rich-earth text-cream font-medium"
              : "text-warm-stone hover:bg-clay-beige hover:text-rich-earth"
          }"><span>${cat}</span><span class="font-mono text-xs opacity-70">${counts[cat] || 0}</span></button>`;
        })
        .join("");
      const list = document.getElementById("categoryList");
      const drawerList = document.getElementById("drawerCategoryList");
      if (list) list.innerHTML = html;
      if (drawerList) drawerList.innerHTML = html;
      document.querySelectorAll<HTMLElement>("[data-category]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const cat = btn.getAttribute("data-category");
          if (cat) filterByCategory(cat);
        });
      });
    }

    function filterByCategory(cat: string) {
      currentCategory = cat;
      renderCategories();
      applyFilters();
      updateUrl();
      closeDrawer();
    }

    function applyFilters() {
      const grid = document.getElementById("cloudsGrid");
      const empty = document.getElementById("emptyState");
      if (!grid) return;

      const cards = Array.from(grid.querySelectorAll<HTMLElement>("article.cloud-card"));
      const term = searchTerm.toLowerCase();
      let visibleCount = 0;

      const matches: HTMLElement[] = [];
      for (const card of cards) {
        const cats = (card.dataset.categories || "").split("|");
        const name = card.dataset.name || "";
        const desc = card.dataset.description || "";
        const inCat = currentCategory === "All" || cats.includes(currentCategory);
        const inSearch = term === "" || name.includes(term) || desc.includes(term);
        if (inCat && inSearch) {
          card.classList.remove("hidden");
          matches.push(card);
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      }

      // Apply sort by reordering DOM
      matches.sort((a, b) => {
        if (currentSort === "alphabetical") {
          return (a.dataset.name || "").localeCompare(b.dataset.name || "");
        }
        const da = a.dataset.dateAdded || "";
        const db = b.dataset.dateAdded || "";
        if (!da && !db) return 0;
        if (!da) return 1;
        if (!db) return -1;
        return db.localeCompare(da);
      });

      for (const card of matches) grid.appendChild(card);

      if (empty) {
        empty.classList.toggle("hidden", visibleCount > 0);
      }
    }

    // Search input
    const searchInput = document.getElementById("searchInput") as HTMLInputElement | null;
    const searchClear = document.getElementById("searchClear");

    function updateSearchClear() {
      if (!searchClear) return;
      const visible = searchTerm.length > 0;
      searchClear.classList.toggle("hidden", !visible);
      searchClear.classList.toggle("flex", visible);
    }

    function clearSearch() {
      searchTerm = "";
      if (searchInput) searchInput.value = "";
      updateSearchClear();
      applyFilters();
      updateUrl();
    }

    searchInput?.addEventListener("input", (e) => {
      searchTerm = (e.target as HTMLInputElement).value;
      updateSearchClear();
      applyFilters();
      updateUrl();
    });
    searchClear?.addEventListener("click", clearSearch);

    // Sort
    const sortSelect = document.getElementById("sortSelect") as HTMLSelectElement | null;
    sortSelect?.addEventListener("change", () => {
      currentSort = (sortSelect.value as "alphabetical" | "recent") || "alphabetical";
      applyFilters();
    });

    function updateUrl() {
      const params = new URLSearchParams();
      if (searchTerm) params.set("search", searchTerm);
      const hash = currentCategory === "All" ? "" : "#" + categoryToSlug(currentCategory);
      const qs = params.toString() ? "?" + params.toString() : "";
      history.replaceState(null, "", location.pathname + qs + hash);
    }

    function initFromUrl() {
      const params = new URLSearchParams(location.search);
      const s = params.get("search") || "";
      if (s) {
        searchTerm = s;
        if (searchInput) searchInput.value = s;
      }
      const slug = location.hash.slice(1);
      if (slug && !HASH_MODALS[slug]) {
        const matched = slugToCategory(slug);
        if (matched !== "All") currentCategory = matched;
      }
    }

    window.addEventListener("popstate", () => {
      const params = new URLSearchParams(location.search);
      searchTerm = params.get("search") || "";
      if (searchInput) searchInput.value = searchTerm;
      updateSearchClear();
      const slug = location.hash.slice(1);
      currentCategory = slug && !HASH_MODALS[slug] ? slugToCategory(slug) : "All";
      renderCategories();
      applyFilters();
    });

    // Init
    initFromUrl();
    updateSearchClear();
    renderCategories();
    applyFilters();

    // Open modal if loaded with hash
    const initModalId = HASH_MODALS[location.hash.slice(1)];
    if (initModalId) openModal(initModalId);
  </script>
</Base>
