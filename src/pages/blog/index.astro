---
/** Blog index (Figma node 1:3561). Date + category filters run client-side. */
import PixelIcon from "../../components/blog/PixelIcon.astro";
import SidebarShell from "../../components/site/SidebarShell.astro";
import Base from "../../layouts/Base.astro";
import { formatShortDate, getPublishablePosts, postUrl, sortedByDate } from "../../lib/blog";
import { iconForSlug } from "../../lib/pixel-icons";
import { getPageMeta } from "../../lib/site-meta";
import { absoluteUrl } from "../../lib/site-urls";

const { title, description } = getPageMeta("blog");
const blogCanonical = `${absoluteUrl("blog")}/`;
const posts = sortedByDate(await getPublishablePosts());
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title={title} description={description} canonical={blogCanonical} nav="blog">
  <SidebarShell railLabel="Blog filters">
    <Fragment slot="rail">
      <div class="rail-block">
        <h1 class="font-mono text-[30px] leading-[38px] font-bold">Blog</h1>
        <p class="mt-3 text-sm">
          Short-form notes on alternative cloud providers — trends, new entrants, and commentary from
          the Alt Clouds community.
        </p>
      </div>
      {
        posts.length > 1 && (
          <form class="rail-block flex flex-col gap-2" onsubmit="return false">
            <p class="field-label mb-1">Filter by</p>
            <label class="sr-only" for="postSort">Sort by date</label>
            <select id="postSort" class="select-field">
              <option value="newest">Date: Newest</option>
              <option value="oldest">Date: Oldest</option>
            </select>
            <label class="sr-only" for="postTag">Category</label>
            <select id="postTag" class="select-field">
              <option value="">Category: All</option>
              {allTags.map((t) => <option value={t}>Category: #{t}</option>)}
            </select>
          </form>
        )
      }
    </Fragment>

    {
      posts.length === 0 ? (
        <p class="p-10">No posts published yet. Check back soon.</p>
      ) : (
        <ol id="postList">
          {posts.map((post) => (
            <li
              class="relative flex items-center gap-5 border-b-2 border-midnight p-10 hover:bg-paper max-md:items-start max-md:px-4 max-md:py-6"
              data-date={post.data.publishDate.toISOString()}
              data-tags={post.data.tags.join("|")}>
              <PixelIcon
                name={post.data.icon ?? iconForSlug(post.id)}
                class="max-md:size-16 max-md:[&_svg]:scale-[.64]"
              />
              <div class="min-w-0">
                <p class="flex flex-wrap gap-x-5 gap-y-1 text-sm uppercase">
                  <time class="opacity-80" datetime={post.data.publishDate.toISOString()}>
                    {formatShortDate(post.data.publishDate)}
                  </time>
                  {post.data.tags.map((tag) => (
                    <span class="opacity-40">#{tag}</span>
                  ))}
                </p>
                <h2 class="mt-3 text-[20px] leading-7">
                  <a
                    href={postUrl(post.id)}
                    class="underline underline-offset-4 after:absolute after:inset-0 hover:bg-mint">{post.data.title}</a>
                </h2>
                <p class="mt-3 text-midnight/60">{post.data.description}</p>
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </SidebarShell>
</Base>

<script>
  const list = document.getElementById("postList");
  const sortEl = document.getElementById("postSort") as HTMLSelectElement | null;
  const tagEl = document.getElementById("postTag") as HTMLSelectElement | null;
  function apply() {
    if (!list) return;
    const rows = Array.from(list.children) as HTMLElement[];
    const dir = sortEl?.value === "oldest" ? 1 : -1;
    rows.sort((a, b) => dir * (a.dataset.date ?? "").localeCompare(b.dataset.date ?? ""));
    for (const row of rows) {
      const tags = (row.dataset.tags ?? "").split("|");
      row.hidden = Boolean(tagEl?.value) && !tags.includes(tagEl!.value);
      list.appendChild(row);
    }
  }
  sortEl?.addEventListener("change", apply);
  tagEl?.addEventListener("change", apply);
</script>
