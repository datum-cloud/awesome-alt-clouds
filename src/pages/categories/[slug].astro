---
import Base from "../../layouts/Base.astro";
import CloudCard from "../../components/CloudCard.astro";
import DetailTopBar from "../../components/DetailTopBar.astro";
import DirectorySidebar from "../../components/DirectorySidebar.astro";
import { asset } from "../../lib/assets";
import { getCategoryDescription } from "../../lib/categories";
import {
  categoryToSlug,
  clouds,
  countByCategory,
  getCategories,
} from "../../lib/clouds";
import { EMERGING_CATEGORY } from "../../lib/github";
import { getFeaturedSlugs } from "../../lib/profile";
import { siteName } from "../../lib/site-meta";
import { absoluteUrl } from "../../lib/site-urls";

export function getStaticPaths() {
  return getCategories()
    .filter((cat) => cat !== "All")
    .map((category) => ({
      params: { slug: categoryToSlug(category) },
      props: { category },
    }));
}

interface Props {
  category: string;
}

const { category } = Astro.props;
const slug = categoryToSlug(category);
const categoryClouds = [...clouds]
  .filter((c) => c.categories.includes(category))
  .sort((a, b) => a.name.localeCompare(b.name));
const featuredSlugs = await getFeaturedSlugs();
const providerCount = countByCategory(category);
const description = getCategoryDescription(category);
const pageTitle = `${category} | ${siteName}`;
const canonical = `${absoluteUrl("categories/" + slug)}/`;
const sidebarActivePage = category === EMERGING_CATEGORY ? "emerging" : "directory";

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: category,
  description,
  url: canonical,
  isPartOf: {
    "@type": "WebSite",
    name: "Alt Cloud",
    url: absoluteUrl(""),
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: providerCount,
    itemListElement: categoryClouds.slice(0, 50).map((cloud, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: cloud.name,
      url: cloud.url,
    })),
  },
};

const compareHref = asset("compare/");
const homeCategoryHref = `${asset("")}#${slug}`;
---

<Base title={pageTitle} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>

  <div class="flex flex-col md:flex-row min-h-screen">
    <DirectorySidebar activePage={sidebarActivePage} />

    <main class="flex-1 p-5 md:p-8 min-w-0">
      <DetailTopBar featuredSlugs={[...featuredSlugs]} />

      <div class="max-w-6xl">
        <header class="mb-8">
          <nav class="text-xs text-warm-stone mb-3" aria-label="Breadcrumb">
            <a href={asset("")} class="hover:text-rich-earth transition-colors no-underline">
              Directory
            </a>
            <span class="mx-1.5">/</span>
            <span class="text-rich-earth">{category}</span>
          </nav>
          <h1 class="font-serif text-3xl md:text-4xl font-semibold text-rich-earth mb-3">
            {category}
          </h1>
          <p class="text-warm-stone leading-relaxed max-w-3xl mb-4">{description}</p>
          <div class="flex flex-wrap items-center gap-4 text-sm">
            <span class="text-warm-stone">
              {providerCount} provider{providerCount === 1 ? "" : "s"}
            </span>
            <a
              href={compareHref}
              class="font-medium text-bright-tangerine hover:underline no-underline">
              Compare providers →
            </a>
            <a
              href={homeCategoryHref}
              class="font-medium text-warm-stone hover:text-rich-earth transition-colors no-underline">
              Filter on homepage
            </a>
          </div>
        </header>

        {
          categoryClouds.length === 0 ? (
            <p class="text-warm-stone py-8">No providers in this category yet.</p>
          ) : (
            <div class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(300px,1fr))] md:grid-cols-[repeat(auto-fill,minmax(320px,1fr))]">
              {categoryClouds.map((cloud, index) => (
                <CloudCard
                  cloud={cloud}
                  featured={featuredSlugs.has(cloud.slug)}
                  index={index}
                />
              ))}
            </div>
          )
        }
      </div>
    </main>
  </div>
</Base>
