---
import Base from "../../layouts/Base.astro";
import CloudRow from "../../components/list/CloudRow.astro";
import CloudTable from "../../components/list/CloudTable.astro";
import SidebarShell from "../../components/site/SidebarShell.astro";
import { asset } from "../../lib/assets";
import { CATEGORY_BLURBS, getCategoryDescription } from "../../lib/categories";
import {
  categoryToSlug,
  clouds,
  countByCategory,
  getCategories,
} from "../../lib/clouds";
import { getListItems } from "../../lib/list-items";
import { siteName } from "../../lib/site-meta";
import { absoluteUrl } from "../../lib/site-urls";

export function getStaticPaths() {
  return getCategories()
    .filter((cat) => cat !== "All")
    .map((category) => ({
      params: { slug: categoryToSlug(category) },
      props: { category },
    }));
}

interface Props {
  category: string;
}

const { category } = Astro.props;
const slug = categoryToSlug(category);
const categoryClouds = [...clouds]
  .filter((c) => c.categories.includes(category))
  .sort((a, b) => a.name.localeCompare(b.name));
const items = await getListItems(categoryClouds);
const providerCount = countByCategory(category);
const description = getCategoryDescription(category);
const pageTitle = `${category} | ${siteName}`;
const canonical = `${absoluteUrl("categories/" + slug)}/`;

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: category,
  description,
  url: canonical,
  isPartOf: {
    "@type": "WebSite",
    name: "Alt Cloud",
    url: absoluteUrl(""),
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: providerCount,
    itemListElement: categoryClouds.slice(0, 50).map((cloud, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: cloud.name,
      url: cloud.url,
    })),
  },
};

const listHref = asset(`list/?category=${slug}`);
---

<Base title={pageTitle} description={description} canonical={canonical} nav="list">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>

  <SidebarShell railLabel={category}>
    <div slot="rail" class="rail-block">
      <nav class="eyebrow mb-4" aria-label="Breadcrumb">
        <a href={asset("list/")} class="underline">The list</a> / {category}
      </nav>
      <h1 class="display text-[28px] leading-[32px]">{category}</h1>
      <p class="mt-4 text-sm">{CATEGORY_BLURBS[category] ?? description}</p>
      <p class="mt-4 text-sm opacity-80">{description}</p>
      <p class="mt-6 text-sm">{providerCount} provider{providerCount === 1 ? "" : "s"}</p>
      <p class="mt-4"><a class="arrow-link" href={listHref}>View in list →</a></p>
    </div>

    <div class="px-10 pb-10 pt-9 max-lg:px-4">
      {
        items.length === 0 ? (
          <p class="py-8">No providers in this category yet.</p>
        ) : (
          <CloudTable>
            {items.map((item) => (
              <CloudRow item={item} />
            ))}
          </CloudTable>
        )
      }
    </div>
  </SidebarShell>
</Base>
