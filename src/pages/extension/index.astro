---
/** Browser extension page (replaces the old Extension modal; not in the Figma set). */
import SidebarShell from "../../components/site/SidebarShell.astro";
import Base from "../../layouts/Base.astro";
import { EXTENSION_LINKS } from "../../lib/site-links";
import { absoluteUrl } from "../../lib/site-urls";

const browsers = [
  { name: "Google Chrome", href: EXTENSION_LINKS.chrome },
  { name: "Mozilla Firefox", href: EXTENSION_LINKS.firefox },
  { name: "Microsoft Edge", href: null },
];
---

<Base
  title="Alt Clouds Checker browser extension | Alt Clouds"
  description="See whether the site you're on is an alternative cloud listed on Alt Clouds, and request a listing in one click."
  canonical={absoluteUrl("extension/")}>
  <SidebarShell railLabel="Extension">
    <div slot="rail" class="rail-block">
      <h1 class="font-mono text-[30px] leading-[38px] font-bold">Browser extension</h1>
      <p class="mt-3 text-sm">Alt Clouds Checker tells you whether the site you're on is listed in the directory.</p>
    </div>

    <div class="p-10 max-lg:px-4">
      <ul class="grid max-w-[960px] grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-px border border-midnight bg-midnight">
        {
          browsers.map((b) => (
            <li class="flex flex-col gap-6 bg-white p-8">
              <p class="display text-lg">{b.name}</p>
              {b.href ? (
                <a class="btn btn--dark" href={b.href} target="_blank" rel="noopener noreferrer">
                  <span aria-hidden="true">+</span>
                  <span class="btn__label">Add to browser</span>
                </a>
              ) : (
                <span class="btn btn--outline border border-midnight opacity-60">Coming soon</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </SidebarShell>
</Base>
